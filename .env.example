# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by API routes and the Edge Function for storage writes
# and to bypass RLS for the scheduled recheck. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Facebook session storage (per-user) ---
# Encryption key for the Facebook session cookie every app user connects
# at /connect-facebook (see src/lib/crypto.ts, facebook_sessions table).
# Generate with: openssl rand -hex 32
FACEBOOK_COOKIE_ENCRYPTION_KEY=

# Superseded by per-user sessions above — no longer read anywhere. Left
# here only as a note in case you're migrating from an older deployment
# that used it.
# FACEBOOK_SESSION_COOKIE=

# Useful during development so the rest of the app (upload/dedupe/gallery,
# and the two on-demand download routes) works without hitting Facebook on
# every request. Leave unset in production.
# MOCK_EXTRACTION=true

# Required in production — shared secret the scheduled sweep route checks
# (see src/app/api/cron/check-all-links/route.ts and
# supabase/migrations/0002_cron.sql). Generate with: openssl rand -hex 32
CRON_SECRET=
