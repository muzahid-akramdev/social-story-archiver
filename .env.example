# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by API routes for storage writes and to bypass RLS
# for the scheduled crawl. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required in production — shared secret the scheduled crawl route
# checks (see src/app/api/cron/check-all-links/route.ts and
# supabase/migrations/0005_cron_every_8h.sql).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Extraction (v2) ---
# Strategy order (see src/lib/extraction/facebook.ts and spec §5):
#   1. storyphp-og — anonymous, opportunistic (post-backed public
#      profile stories only)
#   2. session-ssr — the DEDICATED account session below; the only
#      route that reaches pure stories and Page stories
#   3. session-free URL fetch (public posts/videos)
#   4. media-endpoint fetch with a per-user cookie, if connected
# No strategy ever loads the story player or calls a view-logging
# endpoint, so no fetch ever registers a "seen".
#
# Useful during development so the rest of the app (compression, ZIP
# archives, dedupe, galleries, the crawl) works end-to-end without
# touching Facebook at all. Leave unset in production.
# MOCK_EXTRACTION=true

# --- Dedicated Facebook account session (strategy 2: session-ssr) ---
# OPTIONAL for the anonymous strategies; REQUIRED for full coverage
# (pure stories + Page stories). Use a DEDICATED Facebook account
# created only for this tool — never your personal account: any
# checkpoint/ban risk sits on that account by design.
#
# How to get the value: log in as the dedicated account in a browser,
# open DevTools → Network, load facebook.com, pick the document
# request, and copy its full "Cookie" request header (one line,
# semicolon-separated). It must include c_user, xs, datr, sb and fr.
# The account can only fetch stories it can SEE: public stories work
# with any account; friends-audience stories need the account to be
# friends with the poster; Page folders need it to follow the Page.
# Cookies expire over time — when /admin reports the dedicated
# session as fb_session_expired, repeat the copy above and replace
# this value. Server-only: never expose it to the client, never log
# it (the app redacts it from error output).
# FB_SESSION_COOKIE=c_user=...; xs=...; datr=...; sb=...; fr=...

# --- Optional egress proxy for dedicated-session fetches ---
# From Vercel's datacenter IPs, Facebook's GraphQL gateway refuses
# the dedicated session's bucket query (error 1357004) while serving
# page GETs. When BOTH values are set, every dedicated-session fetch
# (dtsg bootstrap, bucket discovery, stories SSR legs, GraphQL POST)
# is tunnelled through the fb-egress Cloudflare Worker in worker/
# (see worker/README.md) so requests leave from Cloudflare's network.
# FB_EGRESS_PROXY_SECRET must equal the Worker's EGRESS_SECRET.
# Generate with: openssl rand -hex 32
# FB_EGRESS_PROXY_URL=https://fb-egress.<subdomain>.workers.dev
# FB_EGRESS_PROXY_SECRET=

# --- Optional per-user Facebook sessions (v1 feature, not required) ---
# Individual app users MAY connect their own Facebook session at
# /connect-facebook (used only as an extraction fallback for that
# user's own folders). This key encrypts those cookies at rest
# (see src/lib/crypto.ts, facebook_sessions table).
# Generate with: openssl rand -hex 32
FACEBOOK_COOKIE_ENCRYPTION_KEY=
